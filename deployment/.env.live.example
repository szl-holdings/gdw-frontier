# Copy to an ignored file outside the repository and replace every bracketed value.
GDW_API_TOKEN_SOURCE_FILE=[ABSOLUTE_PATH_TO_API_TOKEN_FILE]
GDW_BIND_ADDRESS=127.0.0.1
GDW_DEPLOYMENT_MODE=SINGLE_NODE_LIVE
GDW_GRAFANA_PORT=3300
GDW_IMAGE_DIGEST=[SET_TO_DOCKER_IMAGE_ID]
GDW_IMAGE_REF=gdw-frontier:[SET_TO_EXACT_SOURCE_SHA]
GDW_REQUIRE_AUTH=1
GDW_SOURCE_SHA=[SET_TO_EXACT_SOURCE_SHA]
GDW_WORKERS=2
GRAFANA_ADMIN_PASSWORD_SOURCE_FILE=[ABSOLUTE_PATH_TO_GRAFANA_PASSWORD_FILE]
GRAFANA_ANONYMOUS_ENABLED=false
