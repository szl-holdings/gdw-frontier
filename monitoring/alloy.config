logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "gdw" {
  path_targets = [{
    "__path__" = "/var/log/gdw/gdw.log",
    "job"      = "gdw",
    "service"  = "gdw",
  }]
}

loki.source.file "gdw" {
  targets       = local.file_match.gdw.targets
  forward_to    = [loki.process.gdw.receiver]
  tail_from_end = false
}

loki.process "gdw" {
  stage.json {
    expressions = {
      level = "level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.gdw.receiver]
}

loki.write "gdw" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

